{
  "extends": ["vaadin", "prettier"],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 2015,
    "sourceType": "module"
  },
  "rules": {
    "max-len": ["error", { "code": 150 }]
  },
  "globals": {
    "smoothscroll": "off"
  }
}
